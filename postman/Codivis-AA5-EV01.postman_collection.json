{
  "info": {
    "name": "Codivis API - AA5-EV01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa y en orden. Datos nuevos por ejecucion. Body x-www-form-urlencoded; respuestas JSON. Login solo verifica credenciales, no emite token ni crea sesion."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086/crm/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "clave",
      "value": "PruebaCodivis2026!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 - Estado') {",
          "  const id = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 20);",
          "  pm.collectionVariables.set('usuario', 'prueba_' + id);",
          "  pm.collectionVariables.set('otro', 'otro_' + id);",
          "  pm.collectionVariables.set('inexistente', 'no_' + id);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Estado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON y contrato\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "  const data = pm.response.json();",
              "  pm.expect(data.codigo).to.eql(\"API_DISPONIBLE\");",
              "  pm.expect(data.ok).to.eql(true);",
              "  pm.expect(data.mensaje).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data).not.to.have.property(\"clave\");",
              "  pm.expect(data).not.to.have.property(\"hash\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Registrar usuario",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/registro",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "usuario",
              "value": "{{usuario}}",
              "type": "text"
            },
            {
              "key": "clave",
              "value": "{{clave}}",
              "type": "text"
            },
            {
              "key": "confirmacion",
              "value": "{{clave}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON y contrato\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "  const data = pm.response.json();",
              "  pm.expect(data.codigo).to.eql(\"USUARIO_CREADO\");",
              "  pm.expect(data.ok).to.eql(true);",
              "  pm.expect(data.mensaje).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data).not.to.have.property(\"clave\");",
              "  pm.expect(data).not.to.have.property(\"hash\");",
              "});"
            ]
          }
        }
      ]
    },
